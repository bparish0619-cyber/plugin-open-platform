<?xml version="1.0" encoding="utf-8"?>
<!-- Smart glasses with two HUD lines in the right lens. 108x108 adaptive-icon
     canvas; all artwork stays inside the central 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to 80% so the temples clear circular masks. -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.8" android:scaleY="0.8">
        <!-- Lenses: rounded rectangles 26 wide, 20 tall. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M30,44 h14 a6,6 0 0 1 6,6 v8 a6,6 0 0 1 -6,6 h-14 a6,6 0 0 1 -6,-6 v-8 a6,6 0 0 1 6,-6 z
                M64,44 h14 a6,6 0 0 1 6,6 v8 a6,6 0 0 1 -6,6 h-14 a6,6 0 0 1 -6,-6 v-8 a6,6 0 0 1 6,-6 z" />
        <!-- Bridge and temple stubs. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M50,51 q4,-5 8,0 M24,49 l-2,-3 M84,49 l2,-3" />
        <!-- HUD text lines shown in the right lens. -->
        <path
            android:strokeColor="@color/ic_launcher_hud"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M64,51 h12 M64,57 h7" />
    </group>
</vector>
